NODE_ENV=development
PORT=5000

# Database (required)
MONGODB_URI=mongodb://localhost:27017/pet-adoption

# Redis (optional; if omitted, Redis-backed features should be disabled)
REDIS_URL=redis://localhost:6379

# Auth (required)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (required for browser login/cookies)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Security
BCRYPT_ROUNDS=12

# Cloudinary (optional; required only for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email/OTP (currently not used by the codebase, kept for future work)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OTP_EXPIRY=300
OTP_LENGTH=6
